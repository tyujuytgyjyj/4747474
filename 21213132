// ---------- chat: reset session, then send ----------
function regen(i){const c=get();c.msgs=c.msgs.slice(0,i);stream()}
function paint(m,fin){
  const el=$('a'+get().msgs.indexOf(m));if(!el)return;
  el.innerHTML=md(m.c)+(fin?'':'<span class="cur"></span>');
  const f=$('feed');if(f.scrollHeight-f.scrollTop-f.clientHeight<200)f.scrollTop=f.scrollHeight;
}
async function readSSE(r,m){
  const rd=r.body.getReader(),dec=new TextDecoder();let buf='',raw='';
  for(;;){
    const {done,value}=await rd.read();if(done)break;
    const chunk=dec.decode(value,{stream:true});raw+=chunk;buf+=chunk;
    const lines=buf.split('\n');buf=lines.pop();
    for(const l of lines){
      const s=l.trim();if(!s.startsWith('data:'))continue;
      const d=s.slice(5).trim();if(d==='[DONE]')return paint(m,1);
      try{const x=JSON.parse(d).choices?.[0]?.delta?.content;if(x){m.c+=x;paint(m)}}catch(e){}
    }
  }
  if(!m.c){try{m.c=JSON.parse(raw).choices?.[0]?.message?.content||''}catch(e){}}  // السيرفر تجاهل stream وأرسل JSON
  paint(m,1);
}
async function readJSON(r,m){
  const x=await r.text();let j;
  try{j=JSON.parse(x)}catch(e){throw new Error('رد غير صالح (ليس JSON):\n'+x.slice(0,300))}
  m.c=j.choices?.[0]?.message?.content??(j.error?(j.error.message||JSON.stringify(j.error)):JSON.stringify(j));
  paint(m,1);
}
async function stream(){
  const c=get(),m={r:'a',c:''},t0=performance.now();
  busy=true;ctrl=new AbortController();btn();render();
  const th=document.createElement('div');th.className='think';th.innerHTML='<i></i><i></i><i></i><span>جارٍ الاتصال…</span>';$('col').append(th);bottom();
  try{
    const sig=ctrl.signal,base=c.msgs.filter(x=>!x.err),last=base[base.length-1];
    if(cfg.reset){
      th.lastChild.textContent='تصفير الجلسة…';
      const r=await call('/reset-session?agent=all',{method:'POST',headers:auth(),signal:sig});
      if(!r.ok)throw await httpErr(r,'فشل تصفير الجلسة');
    }
    th.lastChild.textContent='بانتظار الرد…';
    const body=x=>{const im=(x.f||[]).filter(f=>f&&f.th);return im.length?[{type:'text',text:x.c||'ماذا في هذه الصورة؟'},...im.map(f=>({type:'image_url',image_url:{url:f.img||f.th}}))]:x.c};
    const messages=cfg.hist?base.map(x=>({role:x.r==='u'?'user':'assistant',content:x.r==='u'?body(x):x.c})):[{role:'user',content:body(last)}];
    const hasImg=messages.some(x=>Array.isArray(x.content));
    const r=await call('/v1/chat/completions',{method:'POST',headers:{'Content-Type':'application/json',...auth()},body:JSON.stringify({model:hasImg?cfg.vmodel:cfg.model,messages,stream:cfg.stream}),signal:sig});
    if(!r.ok)throw await httpErr(r);
    th.remove();c.msgs.push(m);render();
    if(cfg.stream&&r.body)await readSSE(r,m);else await readJSON(r,m);
    m.ms=Math.round(performance.now()-t0);m.mdl=hasImg?cfg.vmodel:cfg.model;if(!m.c)m.c='(رد فارغ من السيرفر)';
  }catch(e){
    th.remove();
    if(e.name!=='AbortError')c.msgs.push({r:'a',c:e.message,err:1});
  }
  const i=c.msgs.indexOf(m);if(i>=0&&!m.c)c.msgs.splice(i,1);
  busy=false;ctrl=null;save();btn();render();drawList();
}
function stop(){if(ctrl)ctrl.abort()}
drawList();render();drawNotes();drawLog();
</script>
</body>
