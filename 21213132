// ---------- network ----------
const auth=()=>cfg.key?{Authorization:'Bearer '+cfg.key}:{};
async function call(path,init){
  const t0=performance.now(),ms=()=>Math.round(performance.now()-t0);
  try{const r=await fetch(cfg.url.replace(/\/+$/,'')+path,init);log(path,r.status,ms(),r.ok);return r}
  catch(e){
    if(e.name==='AbortError')throw e;
    log(path,'ERR',ms(),false,e.message);
    throw new Error('Network Error — تعذّر الاتصال بـ '+cfg.url+'\n• تأكد أن السيرفر المحلي يعمل\n• إن فُتحت الصفحة من ملف فيجب أن يسمح السيرفر بـ CORS:\n  Access-Control-Allow-Origin, Access-Control-Allow-Headers: Content-Type, Authorization، ويرد على OPTIONS')
  }
}
async function httpErr(r,pre){
  let d='';try{const x=await r.text();try{const j=JSON.parse(x);d=(typeof j.error==='string'?j.error:j.error?.message)||j.message||x}catch(e){d=x}}catch(e){}
  return new Error((pre?pre+' — ':'')+'HTTP '+r.status+(d?': '+String(d).slice(0,300):'')+(/image|vision/i.test(d)?'\n• هذا الموديل لا يدعم الصور — غيّر «موديل الصور» في الإعدادات':'')+(r.status===401||r.status===403?'\n• Invalid Token؟ راجع المفتاح في الإعدادات':''))
}
