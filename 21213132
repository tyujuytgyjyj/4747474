<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Cosmos</title>
<style>
:root{--bg:#fff;--side:#f9f9f9;--text:#0d0d0d;--mute:#6b6b6b;--bubble:#f4f4f4;--comp:#fff;--line:#e5e5e5;--hover:#ececec;--pop:#fff;--code:#f6f6f6;--codeh:#ececec;--acc:#6d5efc;--sh:0 8px 30px #0002}
:root[data-theme=dark]{--bg:#212121;--side:#181818;--text:#ececec;--mute:#9b9b9b;--bubble:#303030;--comp:#2b2b2b;--line:#3a3a3a;--hover:#2c2c2c;--pop:#2f2f2f;--code:#171717;--codeh:#2a2a2a;--sh:0 8px 30px #0008}
*{box-sizing:border-box;margin:0}
html,body{height:100%}
body{font-family:system-ui,-apple-system,"Segoe UI",Tahoma,"Noto Sans Arabic",sans-serif;background:var(--bg);color:var(--text);display:flex;overflow:hidden;transition:background .2s}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
svg{display:block;flex-shrink:0}
aside{width:268px;background:var(--side);display:flex;flex-direction:column;padding:8px;transition:margin .25s;flex-shrink:0;z-index:20}
aside.hide{margin-inline-start:-268px}
.top{display:flex;justify-content:space-between;align-items:center;padding:2px 2px 8px}
.brand{display:flex;gap:8px;align-items:center;font-weight:700;padding:6px 8px}
.logo{width:26px;height:26px;border-radius:8px;background:conic-gradient(from 200deg,#6d5efc,#22d3ee,#a855f7,#6d5efc);display:grid;place-items:center;color:#fff}
.row{display:flex;align-items:center;gap:10px;padding:9px 10px;border-radius:10px;font-size:14px;width:100%;text-align:start}
.row:hover,.ic:hover,.row.on{background:var(--hover)}
.lbl{padding:14px 10px 6px;font-size:12px;color:var(--mute)}
.chats{flex:1;overflow:auto}
.ci{position:relative}
.ci .row span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1}
.ci .del{position:absolute;inset-inline-end:6px;top:6px;padding:4px;border-radius:6px;color:var(--mute);display:none}
.ci:hover .del{display:block}.ci .del:hover{color:#e5484d}
.me{display:flex;align-items:center;gap:10px;padding:10px;border-radius:10px;font-size:14px}
.me:hover{background:var(--hover)}
.av{width:32px;height:32px;border-radius:50%;background:#10a37f;color:#fff;display:grid;place-items:center;font-size:13px}
.me small{display:block;font-size:12px;color:var(--mute)}
main{flex:1;display:flex;flex-direction:column;min-width:0;position:relative}
header{display:flex;align-items:center;gap:4px;padding:10px 12px;position:relative}
.ic{padding:8px;border-radius:9px;color:var(--mute)}
.ic:hover{color:var(--text)}
.model{font-size:17px;padding:7px 12px;border-radius:10px;display:flex;gap:6px;align-items:center}
.model:hover{background:var(--hover)}
.model small{color:var(--mute);font-size:15px}
.menu{position:absolute;background:var(--pop);border:1px solid var(--line);border-radius:16px;padding:6px;box-shadow:var(--sh);display:none;z-index:30}
.menu.open{display:block;animation:pop .12s}
@keyframes pop{from{opacity:0;transform:translateY(-4px)}}
#mm{top:54px;inset-inline-start:52px;width:310px}
.menu button.it{display:flex;justify-content:space-between;align-items:center;width:100%;text-align:start;padding:10px 12px;border-radius:10px}
.menu button.it:hover{background:var(--hover)}
.menu b{display:block;font-weight:500}.menu span{font-size:13px;color:var(--mute)}
.tag{font-size:11px;padding:2px 7px;border-radius:20px;background:var(--acc);color:#fff;margin-inline-start:6px}
#feed{flex:1;overflow:auto;padding:6px 16px;scroll-behavior:smooth}
.col{max-width:760px;margin:0 auto;display:flex;flex-direction:column}
.u{align-self:flex-start;background:var(--bubble);padding:10px 18px;border-radius:22px;max-width:80%;margin:16px 0 4px;line-height:1.75;white-space:pre-wrap;animation:up .25s}
.chip{display:inline-flex;gap:6px;align-items:center;font-size:12px;border:1px solid var(--line);border-radius:10px;padding:4px 8px;margin:0 0 6px 6px;color:var(--mute)}
.uact{align-self:flex-start;display:flex;opacity:0;transition:.15s}
.u+.uact:hover,.uact:hover{opacity:1}
.a{line-height:1.9;margin:16px 0 2px;font-size:16px;animation:up .25s}
@keyframes up{from{opacity:0;transform:translateY(8px)}}
.a p{margin:0 0 12px}.a ul{padding-inline-start:24px;margin:0 0 12px}.a li{margin:4px 0}
.a code{background:var(--bubble);padding:1px 6px;border-radius:6px;font-size:.9em;font-family:ui-monospace,Consolas,monospace}
.code{background:var(--code);border-radius:14px;overflow:hidden;margin:6px 0 14px;border:1px solid var(--line)}
.ch{display:flex;justify-content:space-between;align-items:center;background:var(--codeh);padding:6px 14px;font-size:12px;color:var(--mute);direction:ltr}
.ch button{display:flex;gap:5px;align-items:center;font-size:12px;color:var(--mute)}.ch button:hover{color:var(--text)}
pre{padding:14px;overflow:auto;font:13.5px/1.6 ui-monospace,Consolas,monospace;text-align:left}
.cur{display:inline-block;width:9px;height:9px;border-radius:50%;background:var(--text);margin-inline-start:4px;animation:bl 1s infinite}
@keyframes bl{50%{opacity:.2}}
.think{display:flex;align-items:center;gap:10px;color:var(--mute);margin:20px 0;font-size:15px}
.think i{width:9px;height:9px;border-radius:50%;background:var(--acc);animation:bl .9s infinite}
.think i:nth-child(2){animation-delay:.2s}.think i:nth-child(3){animation-delay:.4s}
.acts{display:flex;gap:2px;margin-bottom:10px}
.acts .on{color:var(--text)}
.empty{min-height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:22px;padding-bottom:40px}
.empty .logo{width:54px;height:54px;border-radius:18px;box-shadow:0 0 50px #6d5efc66}
.empty h1{font-size:28px;font-weight:600;text-align:center}
.sug{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;max-width:560px;width:100%}
.sug button{border:1px solid var(--line);border-radius:16px;padding:12px 16px;text-align:start;font-size:14px;color:var(--mute);transition:.15s}
.sug button:hover{background:var(--hover);color:var(--text);transform:translateY(-2px)}
.sug b{display:block;color:var(--text);font-weight:500;margin-bottom:2px}
.foot{padding:0 16px calc(8px + env(safe-area-inset-bottom,0px))}
.comp{max-width:760px;margin:0 auto;background:var(--comp);border-radius:28px;padding:10px 12px;border:1px solid var(--line);box-shadow:0 2px 12px #0000000d;transition:.2s}
.comp:focus-within{border-color:var(--mute)}
.files{display:flex;flex-wrap:wrap;padding:4px 6px 0}
.files .chip button{display:flex}
.line{display:flex;align-items:flex-end;gap:4px}
textarea{flex:1;background:none;border:0;outline:0;resize:none;font:inherit;font-size:16px;color:inherit;padding:8px;max-height:200px;line-height:1.55}
.send{width:36px;height:36px;border-radius:50%;background:var(--text);color:var(--bg);display:grid;place-items:center;flex-shrink:0;transition:.15s}
.send.mic{background:none;color:var(--mute)}.send.mic:hover{background:var(--hover)}
.send.rec{background:#e5484d;color:#fff;animation:bl 1s infinite}
.note{text-align:center;font-size:12px;color:var(--mute);padding:8px}
#dn{position:absolute;bottom:130px;left:50%;transform:translateX(-50%);width:34px;height:34px;border-radius:50%;background:var(--pop);border:1px solid var(--line);box-shadow:var(--sh);display:none;place-items:center;z-index:5}
#md{position:fixed;inset:0;background:#0006;display:none;align-items:flex-start;justify-content:center;padding-top:12vh;z-index:50}
#md.open{display:flex}
.box{width:min(560px,92vw);background:var(--pop);border-radius:18px;box-shadow:var(--sh);overflow:hidden;border:1px solid var(--line)}
.box .s{display:flex;align-items:center;gap:10px;padding:14px 16px;border-bottom:1px solid var(--line)}
.box input{flex:1;background:none;border:0;outline:0;font:inherit;font-size:16px;color:inherit}
.box .res{max-height:50vh;overflow:auto;padding:6px}
.toast{position:fixed;bottom:90px;left:50%;transform:translateX(-50%);background:var(--text);color:var(--bg);padding:8px 16px;border-radius:20px;font-size:13px;opacity:0;transition:.25s;pointer-events:none;z-index:60}
.toast.on{opacity:1}
#ov{display:none;position:fixed;inset:0;background:#0005;z-index:15}
#pn{width:340px;background:var(--side);border-inline-start:1px solid var(--line);display:flex;flex-direction:column;flex-shrink:0;transition:width .25s;overflow:hidden;z-index:20}
#pn.hide{width:0;border-width:0}
#pn>*{min-width:339px}
.tabs{display:flex;align-items:center;gap:2px;padding:8px;border-bottom:1px solid var(--line)}
.tabs>button:not(.ic){flex:1;padding:8px;border-radius:9px;font-size:14px;color:var(--mute)}
.tabs>button.on{background:var(--hover);color:var(--text)}
.pane{flex:1;overflow:auto;padding:10px}
[hidden]{display:none!important}
.nt{display:flex;gap:4px;align-items:flex-start;background:var(--comp);border:1px solid var(--line);border-radius:14px;padding:8px;margin-top:8px}
.nt textarea{min-height:84px;font-size:14px;padding:4px}
.nt div{display:flex;flex-direction:column}
.pane label{display:block;font-size:12px;color:var(--mute);margin-top:12px}
.pane label input:not([type=checkbox]){display:block;width:100%;margin-top:4px;padding:9px 12px;border-radius:10px;border:1px solid var(--line);background:var(--comp);color:var(--text);font:inherit;font-size:14px;outline:0}
.pane label.chk{display:flex;gap:8px;align-items:center;font-size:14px;color:var(--text)}
.lg{border:1px solid var(--line);border-radius:12px;padding:8px 12px;margin-top:8px;font-size:13px}
.lg div{display:flex;justify-content:space-between;gap:8px}
.lg.ok{border-inline-start:3px solid #10a37f}.lg.bad{border-inline-start:3px solid #e5484d}
.lg small{color:var(--mute);word-break:break-word;white-space:pre-wrap}
.a.err{color:#e5484d;background:#e5484d14;border:1px solid #e5484d55;border-radius:14px;padding:10px 16px;white-space:pre-wrap;font-size:14px;line-height:1.8}
.chip.im{padding:3px;border-radius:12px}
.chip img{width:44px;height:44px;object-fit:cover;border-radius:9px}
.chip.im button{padding:0 6px;color:var(--mute)}
.pic{display:block;max-width:230px;max-height:200px;border-radius:14px;margin:2px 0 8px;cursor:zoom-in}
.meta{font-size:12px;color:var(--mute);align-self:center;margin-inline-start:8px}
.a h3,.a h4,.a h5{margin:18px 0 8px;font-weight:600}.a h3{font-size:20px}.a h4{font-size:18px}.a h5{font-size:16px}
.a ol{padding-inline-start:26px;margin:0 0 12px}
.a blockquote{border-inline-start:3px solid var(--line);padding:2px 14px;margin:0 0 12px;color:var(--mute)}
.a a{color:var(--acc)}
#lb{position:fixed;inset:0;background:#000d;display:none;place-items:center;z-index:70;cursor:zoom-out}
#lb.on{display:grid}#lb img{max-width:92vw;max-height:92vh;border-radius:12px}
#drop{position:fixed;inset:12px;border:2px dashed var(--acc);border-radius:24px;background:var(--bg);opacity:.93;display:none;place-items:center;font-size:22px;z-index:65;pointer-events:none}
#drop.on{display:grid}

/* ===== ChatGPT-replica layer ===== */
:root[data-theme=dark]{--bg:#000;--side:#000;--text:#ececec;--mute:#a0a0a0;--bubble:#2a2a2a;--comp:#2a2a2a;--line:#2e2e2e;--hover:#212121;--pop:#232323;--code:#0b0b0b;--codeh:#1d1d1d;--acc:#4d90fe}
:root:not([data-theme=dark]) .comp{box-shadow:0 0 0 1px var(--line)}
aside{border:0}
.sb-top{display:flex;align-items:center;gap:2px;padding:10px 10px 6px;height:52px}
.sb-brand{font-size:17px;font-weight:600;padding:0 8px}
.sb-top .ic{color:#cfcfcf}
.nav{flex:1;overflow:auto;padding:4px 6px;scrollbar-width:thin;scrollbar-color:#444 transparent}
.nav .row{height:30px;padding:0 10px;font-size:13.5px;gap:14px}
.nav .row svg{width:18px;height:18px}
.nav .row i{line-height:0;display:block}
.nav .lbl{padding:22px 10px 6px;font-size:12.5px;color:#b0b0b0;font-weight:500}
.dim{height:30px;padding:0 10px;display:flex;align-items:center;font-size:13px;color:#5c5c5c}
.pa{width:20px;height:20px;border-radius:50%;background:conic-gradient(from 200deg,#6d5efc,#22d3ee,#a855f7,#6d5efc);flex-shrink:0}
.ci .row{padding:0 10px}
.ci .del{top:3px}
.sb-foot{border-top:1px solid var(--line);padding:10px 12px 12px}
.sb-foot .me{padding:2px 6px;font-size:13px;font-weight:600;line-height:1.3}
.av{background:#e8590c;width:32px;height:32px;font-size:12px;font-weight:600}
.cta{width:100%;height:34px;margin-top:10px;border:1px solid #3a3a3a;border-radius:999px;display:flex;align-items:center;justify-content:center;gap:8px;font-size:13px;font-weight:600}
.cta:hover{background:var(--hover)}
header{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:10px 16px;min-height:58px;gap:8px}
.hs{display:flex}
.he{display:flex;align-items:center;gap:8px;justify-self:end}
.seg{display:flex;gap:2px;padding:3px;border-radius:999px;background:var(--hover)}
.seg button{padding:7px 24px;border-radius:999px;font-size:13.5px;font-weight:600;color:var(--mute);display:flex;gap:6px;align-items:center}
.seg button.on{background:var(--comp);color:var(--text);box-shadow:0 0 0 1px var(--line)}
.offer{display:flex;align-items:center;gap:6px;color:#4d90fe;font-size:13px;font-weight:600;padding:6px 8px;border-radius:10px}
.offer:hover,#tmpb.on{background:var(--hover)}
#tmpb.on{color:var(--text)}
#feed{display:flex}
.col{flex:1;width:100%}
.empty{flex:1;min-height:0;gap:0;padding-bottom:40px}
.empty h1{font-size:21px;font-weight:400;margin-bottom:22px}
#slot{width:100%;max-width:640px}
.sug{display:flex;flex-direction:column;gap:0;width:100%;max-width:640px;margin-top:16px}
.sug .sg{display:flex;align-items:center;gap:14px;height:40px;padding:0 14px;border:0;border-radius:12px;color:#b4b4b4;font-size:14.5px;width:100%;text-align:start;transform:none}
.sug .sg:hover{background:var(--hover);color:var(--text);transform:none}
.comp{width:100%;max-width:640px;margin:0 auto;border:0;border-radius:28px;padding:5px 6px;box-shadow:none}
.foot .comp{max-width:760px}
.comp:focus-within{border-color:transparent}
.line{gap:2px}
.cb{width:32px;height:32px;display:grid;place-items:center;padding:0;border-radius:50%;color:var(--text)}
.cb:hover{background:var(--hover)}
#mic{color:var(--mute)}
#mic.rec{color:#e5484d;animation:bl 1s infinite}
textarea{padding:6px 8px;font-size:15px;line-height:20px;min-height:32px}
textarea:placeholder-shown{text-align:left}
textarea::placeholder{color:#9b9b9b}
.pillw{position:relative;margin-bottom:1px}
.chipm{height:30px;display:flex;align-items:center;gap:6px;padding:0 12px;border-radius:999px;background:#4d90fe26;color:#5aa0ff;font-size:14px;font-weight:500}
.chipm i{line-height:0}
.chipm.fast{background:var(--hover);color:var(--text)}
#mm{top:auto;bottom:42px;left:0;right:auto;inset-inline-start:auto;width:300px}
.send{width:32px;height:32px}
.send.voice{background:#2f6fd6;color:#fff}
.send.rec{animation:none}
@media(max-width:1100px){#pn{position:fixed;inset-block:0;inset-inline-end:0;width:min(340px,92vw);box-shadow:var(--sh)}#pn.hide{margin-inline-end:-380px}}
@media(max-width:760px){aside{position:fixed;inset-block:0;inset-inline-start:0;box-shadow:var(--sh)}aside.hide{margin-inline-start:-280px}#ov.on{display:block}.sug{grid-template-columns:1fr}.empty h1{font-size:22px}#mm{inset-inline-start:12px}}
</style>
</head>
<body>
<aside id="side">
  <div class="sb-top"><span class="sb-brand">Cosmos</span><span style="flex:1"></span><button class="ic" onclick="openSearch()" data-i="search" title="بحث (Ctrl+K)"></button><button class="ic" onclick="tg()" data-i="side"></button></div>
  <div class="nav">
    <button class="row on" id="nc" onclick="newChat()"><i data-i="editsq"></i>دردشة جديدة</button>
    <button class="row" onclick="soon()"><i data-i="images"></i>الصور</button>
    <button class="row" onclick="soon()"><i data-i="clock"></i>المهام المجدولة</button>
    <button class="row" onclick="soon()"><i data-i="lib"></i>المكتبة</button>
    <button class="row" onclick="soon()"><i data-i="at"></i>المكونات الإضافية</button>
    <button class="row" onclick="soon()"><i data-i="term"></i>Cosmos Code</button>
    <button class="row" onclick="soon()"><i data-i="dots"></i>استكشاف</button>
    <div class="lbl">مثبتة</div>
    <button class="row" onclick="soon()"><span class="pa"></span>Cosmos بالعربي</button>
    <div class="lbl">المشروعات</div>
    <div class="dim">لا توجد مشروعات</div>
    <div class="lbl">المحادثات الأخيرة</div>
    <div id="list"></div>
  </div>
  <div class="sb-foot">
    <div class="me"><div class="av">HA</div><div>hasani312<small>مجاني</small></div></div>
    <button class="cta" onclick="soon()"><i data-i="gift" data-s="16"></i>احصل على العرض</button>
  </div>
</aside>
<div id="ov" onclick="tg()"></div>

<main>
  <header>
    <div class="hs"><button class="ic" id="open" onclick="tg()" data-i="side" style="display:none"></button></div>
    <div class="seg"><button id="sg-chat" class="on" onclick="seg(0)">الدردشة</button><button id="sg-work" onclick="seg(1)">العمل <span>✦</span></button></div>
    <div class="he"><button class="offer" onclick="toast('لا توجد عروض حاليًا')"><i data-i="gift" data-s="18"></i>عرض مجاني</button><button class="ic" id="tmpb" onclick="tmpChat()" data-i="temp" title="دردشة مؤقتة"></button></div>
  </header>

  <div id="feed"><div class="col" id="col"></div></div>
  <button id="dn" onclick="bottom()" data-i="down" data-s="18"></button>

  <div class="foot" id="foot">
    <div class="comp" id="comp">
      <div class="files" id="files"></div>
      <div class="line">
        <button class="ic cb" onclick="document.getElementById('fi').click()" data-i="plus" title="إرفاق ملف أو صورة"></button>
        <input type="file" id="fi" multiple hidden>
        <textarea id="t" rows="1" dir="auto" placeholder="اسأل Cosmos"></textarea>
        <div class="pillw"><button class="chipm" id="cm" onclick="menu('mm',event)"><i id="cmi"></i><span id="mn">التفكير</span></button><div class="menu" id="mm"></div></div>
        <button class="ic cb" id="mic" onclick="rec()" data-i="mic" title="تسجيل"></button>
        <button class="send" id="s" onclick="act()"></button>
      </div>
    </div>
    <div class="note" id="note">قد يرتكب Cosmos أخطاء. تحقّق من المعلومات المهمّة.</div>
  </div>
</main>

<section id="pn" class="hide">
  <div class="tabs"><button class="on" data-t="notes" onclick="tab('notes')">ملاحظات</button><button data-t="log" onclick="tab('log')">السجل</button><button data-t="cfg" onclick="tab('cfg')">الإعدادات</button><button class="ic" onclick="panel()" data-i="x" data-s="18"></button></div>
  <div class="pane" id="p-notes"><button class="row" onclick="noteAdd()"><i data-i="plus" data-s="18"></i>ملاحظة جديدة</button><div id="nl"></div></div>
  <div class="pane" id="p-log" hidden><button class="row" onclick="logs=[];drawLog()"><i data-i="trash" data-s="18"></i>مسح السجل</button><div id="lg"></div></div>
  <div class="pane" id="p-cfg" hidden>
    <label>رابط السيرفر المحلي<input id="c-url" dir="ltr"></label>
    <label>Token / API Key (اختياري)<input id="c-key" type="password" dir="ltr"></label>
    <label>الموديل<input id="c-model" dir="ltr"></label>
    <label>موديل الصور (عند إرفاق صورة)<input id="c-vmodel" dir="ltr"></label>
    <label class="chk" style="margin-top:16px"><input type="checkbox" id="c-reset"> تصفير الجلسة قبل كل رسالة</label>
    <label class="chk"><input type="checkbox" id="c-stream"> بث مباشر (stream)</label>
    <label class="chk"><input type="checkbox" id="c-hist"> إرسال سجل المحادثة (يكسر العزل)</label>
    <button class="row" style="margin-top:14px;border:1px solid var(--line);justify-content:center" onclick="ping()">اختبار الاتصال</button>
    <button class="row" id="tb" onclick="theme()" style="margin-top:8px"></button>
    <button class="row" onclick="exportChat()"><i data-i="dl" data-s="18"></i>تصدير الدردشة (Markdown)</button>
  </div>
</section>

