// ---------- markdown ----------
function md(x){const bl=[];let h=x.replace(/&/g,'&amp;').replace(/</g,'&lt;');
h=h.replace(/```(\w*)\n?([\s\S]*?)(```|$)/g,(m,l,c)=>{bl.push([l,c]);return '\u0001'+(bl.length-1)+'\u0001'});
h=h.replace(/`([^`\n]+)`/g,'<code>$1</code>').replace(/\*\*([^*]+)\*\*/g,'<b>$1</b>');
h=h.replace(/^(#{1,3}) (.*)$/gm,(m,a,b)=>'<h'+(a.length+2)+'>'+b+'</h'+(a.length+2)+'>').replace(/^> (.*)$/gm,'<blockquote>$1</blockquote>').replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g,'<a href="$2" target="_blank" rel="noopener">$1</a>');
h=h.replace(/(^|\n)(\d+)\. (.*)/g,'$1<oli>$3</oli>').replace(/(<oli>.*<\/oli>\n?)+/g,m=>'<ol>'+m.replace(/oli>/g,'li>')+'</ol>');
h=h.replace(/(^|\n)- (.*)/g,'$1<li>$2</li>').replace(/(<li>.*<\/li>\n?)+/g,m=>'<ul>'+m+'</ul>');
h=h.split(/\n{2,}/).map(p=>{p=p.trim();return /^(<ul|<ol|<h\d|<blockquote|\u0001)/.test(p)?p:'<p>'+p.replace(/\n/g,'
')+'</p>'}).join('');
return h.replace(/\u0001(\d+)\u0001/g,(m,i)=>{const[l,c]=bl[i];return '<div class="code"><div class="ch"><span>'+(l||'code')+'</span><button onclick="cp(this)">'+svg('copy',14)+' نسخ</button></div><pre>'+c.replace(/\n$/,'')+'</pre></div>'})}

